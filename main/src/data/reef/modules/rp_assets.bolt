summit_no_shade_tint = {}

if G_ENVIRONMENT.name == "summit":
    summit_no_shade_tint["tints"] = [{ "type": "minecraft:constant", "value": 66046 }]

item_model reef:remote {
    "model": {
        "type": "minecraft:condition",
        "property": "minecraft:component",
        "predicate": "minecraft:custom_data",
        "value": {
            "reef": {
                "item": {
                    "components": {
                        "reef:link": {
                            "linked": true
                        }
                    }
                }
            }
        },
        "on_true": {
            "type": "minecraft:model",
            "model": "reef:item/linked_remote",
            **summit_no_shade_tint
        },
        "on_false": {
            "type": "minecraft:model",
            "model": "reef:item/unlinked_remote",
            **summit_no_shade_tint
        }
    }
}